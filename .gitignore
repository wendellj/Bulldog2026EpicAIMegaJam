check_*.bat
convert.ps1
install_*.ps1
setup_*.py

# Dev logs and standups (moved to devlog folder)
standup_*.md
devlog_*.md

# GitHub issue drafts
github_issue_*.md

# Devlog media folder
devlog_media/

# StartForgeMind (separate project)
StartForgeMind.bat

# MetaXR plugins (download from Epic/Meta marketplace - too large for git)
Game/Plugins/MetaXR/
Game/Plugins/MetaXRInteraction/

